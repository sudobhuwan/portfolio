# GitHub integration — server-side only.
#
# Both variables are read exclusively by server/github/config.ts. They are NOT
# prefixed with VITE_, so Vite will never inline them into the client bundle.
#
# Local development: copy this file to `.env` and fill in the values.
# Production (Vercel): add them under Project -> Settings -> Environment Variables.

# The GitHub account whose activity the portfolio displays.
GITHUB_USERNAME=your-github-username

# A personal access token used to authenticate GraphQL requests.
#   - Fine-grained token: no extra permissions needed for public data;
#     add "Read access to metadata" if you want private contribution counts.
#   - Classic token: the `read:user` scope is sufficient.
# Generate one at https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token
